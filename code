  <style>
    /* ============ THEME ============ */
    :root {
      --navy: #0f172a;
      --navy-2: #1e293b;
      --maroon: #7a1f2b;
      --maroon-dark: #5c1620;
      --maroon-soft: #f8ecee;
      --text: #1f2937;
      --muted: #64748b;
      --line: #e5e7eb;
      --bg: #ffffff;
      --bg-alt: #f8fafc;
      --radius: 14px;
      --shadow: 0 10px 30px -12px rgba(15, 23, 42, .18);
      --max: 1120px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: 80px; }
    body { font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif; color: var(--text); background: var(--bg); line-height: 1.65; -webkit-font-smoothing: antialiased; }
    img { max-width: 100%; display: block; }
    a { color: inherit; text-decoration: none; }
    ul { list-style: none; }
    .container { width: 100%; max-width: var(--max); margin: 0 auto; padding: 0 24px; }
    section { padding: 88px 0; }
    .alt { background: var(--bg-alt); }

    .eyebrow { display: inline-block; font-size: .78rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--maroon); margin-bottom: 10px; }
    h2.title { font-family: "Playfair Display", Georgia, serif; font-size: clamp(1.9rem, 3.4vw, 2.5rem); color: var(--navy); line-height: 1.2; margin-bottom: 14px; }
    .lead { color: var(--muted); max-width: 640px; margin-bottom: 44px; }

    /* ============ NAV ============ */
    header { position: fixed; inset: 0 0 auto 0; z-index: 50; background: rgba(255,255,255,.88); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
    .nav { display: flex; align-items: center; justify-content: space-between; height: 68px; }
    .logo { font-family: "Playfair Display", serif; font-weight: 700; font-size: 1.25rem; color: var(--navy); }
    .logo span { color: var(--maroon); }
    .nav ul { display: flex; gap: 26px; align-items: center; }
    .nav ul a { font-size: .9rem; font-weight: 500; color: var(--navy-2); position: relative; padding: 6px 0; transition: color .2s; }
    .nav ul a:hover, .nav ul a.active { color: var(--maroon); }
    .nav ul a.active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: var(--maroon); border-radius: 2px; }
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 999px; font-weight: 600; font-size: .92rem; border: 1.5px solid transparent; cursor: pointer; transition: transform .2s, background .2s, color .2s, border-color .2s; }
    .btn:hover { transform: translateY(-2px); }
    .btn-primary { background: var(--maroon); color: #fff; }
    .btn-primary:hover { background: var(--maroon-dark); }
    .btn-ghost { border-color: rgba(255,255,255,.4); color: #fff; }
    .btn-ghost:hover { background: rgba(255,255,255,.12); }
    .btn-sm { padding: 9px 18px; font-size: .85rem; }
    .menu-btn { display: none; background: none; border: 0; font-size: 1.6rem; cursor: pointer; color: var(--navy); }

    /* ============ HERO ============ */
    .hero { background: radial-gradient(1200px 500px at 85% -10%, rgba(122,31,43,.55), transparent 60%), linear-gradient(135deg, var(--navy) 0%, #172036 100%); color: #fff; padding: 150px 0 90px; }
    .hero-grid { display: grid; grid-template-columns: 1.3fr .8fr; gap: 56px; align-items: center; }
    .hero .tag { display: inline-flex; align-items: center; gap: 8px; font-size: .82rem; padding: 7px 14px; border: 1px solid rgba(255,255,255,.25); border-radius: 999px; color: #e2e8f0; margin-bottom: 22px; }
    .hero .tag i { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 0 4px rgba(74,222,128,.2); }
    .hero h1 { font-family: "Playfair Display", serif; font-size: clamp(2.4rem, 5.6vw, 4rem); line-height: 1.08; margin-bottom: 14px; }
    .hero h1 em { font-style: normal; color: #f3b6bd; }
    .hero .role { font-size: 1.15rem; color: #cbd5e1; margin-bottom: 18px; font-weight: 500; }
    .hero p.summary { color: #cbd5e1; max-width: 560px; margin-bottom: 30px; }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 36px; }
    .socials { display: flex; gap: 12px; flex-wrap: wrap; }
    .socials a { font-size: .85rem; color: #cbd5e1; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12); transition: background .2s; }
    .socials a:hover { background: rgba(255,255,255,.16); color: #fff; }

    /* Profile photo: replace the initials with <img src="images/profile.jpg" alt="Soham Patil"> */
    .photo-wrap { position: relative; justify-self: center; }
    .photo { width: min(340px, 72vw); aspect-ratio: 1 / 1.1; border-radius: 28px; overflow: hidden; background: linear-gradient(160deg, #2a3350, #3a1b24); border: 1px solid rgba(255,255,255,.18); display: grid; place-items: center; box-shadow: 0 30px 60px -20px rgba(0,0,0,.6); }
    .photo img { width: 100%; height: 100%; object-fit: cover; }
    .photo .initials { font-family: "Playfair Display", serif; font-size: 5.5rem; color: rgba(255,255,255,.85); }
    .photo-wrap::before { content: ""; position: absolute; inset: 16px -16px -16px 16px; border: 2px solid rgba(243,182,189,.45); border-radius: 28px; z-index: -1; }

    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 70px; }
    .stat { padding: 20px; border-radius: var(--radius); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); }
    .stat b { display: block; font-family: "Playfair Display", serif; font-size: 1.9rem; color: #fff; }
    .stat span { font-size: .82rem; color: #cbd5e1; }

    /* ============ ABOUT ============ */
    .about-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: start; }
    .about-grid p { color: #374151; margin-bottom: 16px; }
    .info-card { background: var(--bg-alt); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; }
    .info-card li { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px dashed var(--line); font-size: .92rem; }
    .info-card li:last-child { border-bottom: 0; }
    .info-card li span { color: var(--muted); }
    .info-card li b { font-weight: 600; color: var(--navy); text-align: right; }

    /* ============ CARDS / TIMELINE ============ */
    .timeline { position: relative; padding-left: 30px; }
    .timeline::before { content: ""; position: absolute; left: 7px; top: 6px; bottom: 6px; width: 2px; background: var(--line); }
    .t-item { position: relative; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 26px; margin-bottom: 20px; transition: box-shadow .25s, transform .25s; }
    .t-item:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
    .t-item::before { content: ""; position: absolute; left: -30px; top: 30px; width: 16px; height: 16px; border-radius: 50%; background: #fff; border: 3px solid var(--maroon); }
    .t-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; margin-bottom: 6px; }
    .t-head h3 { font-size: 1.08rem; color: var(--navy); }
    .date { font-size: .82rem; font-weight: 600; color: var(--maroon); background: var(--maroon-soft); padding: 4px 12px; border-radius: 999px; white-space: nowrap; align-self: flex-start; }
    .org { color: var(--muted); font-size: .93rem; margin-bottom: 10px; font-weight: 500; }
    .t-item p { font-size: .95rem; color: #374151; }
    .badge-live { display: inline-block; margin-left: 8px; font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; background: #dcfce7; color: #166534; vertical-align: middle; }

    /* ============ EDUCATION ============ */
    .edu-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .edu-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; position: relative; overflow: hidden; }
    .edu-card.primary { border-color: var(--maroon); box-shadow: var(--shadow); }
    .edu-card.primary::after { content: "Current"; position: absolute; top: 16px; right: -30px; transform: rotate(40deg); background: var(--maroon); color: #fff; font-size: .68rem; font-weight: 700; padding: 3px 34px; letter-spacing: .08em; text-transform: uppercase; }
    .edu-card .yr { font-size: .8rem; font-weight: 600; color: var(--maroon); letter-spacing: .08em; text-transform: uppercase; }
    .edu-card h3 { margin: 8px 0 4px; color: var(--navy); font-size: 1.05rem; }
    .edu-card .inst { color: var(--muted); font-size: .92rem; min-height: 46px; }
    .edu-card .score { margin-top: 16px; padding-top: 14px; border-top: 1px dashed var(--line); display: flex; justify-content: space-between; align-items: baseline; font-size: .85rem; color: var(--muted); }
    .edu-card .score b { font-family: "Playfair Display", serif; font-size: 1.6rem; color: var(--navy); }

    /* ============ PROJECT ============ */
    .project { display: grid; grid-template-columns: 1fr 1.1fr; gap: 0; background: #fff; border: 1px solid var(--line); border-radius: 20px; overflow: hidden; box-shadow: var(--shadow); }
    /* Project image: add <img src="images/project-atv.jpg" alt="..."> inside .project-media and delete the placeholder div */
    .project-media { background: linear-gradient(150deg, var(--navy), #3a1b24); min-height: 320px; display: grid; place-items: center; color: rgba(255,255,255,.7); text-align: center; padding: 24px; }
    .project-media img { width: 100%; height: 100%; object-fit: cover; }
    .project-media .ph { font-size: .9rem; }
    .project-media .ph b { display: block; font-size: 2.2rem; margin-bottom: 6px; }
    .project-body { padding: 36px; }
    .project-body .meta { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
    .chip { font-size: .78rem; font-weight: 600; padding: 5px 12px; border-radius: 999px; background: var(--maroon-soft); color: var(--maroon); }
    .chip.plain { background: #f1f5f9; color: var(--navy-2); }
    .project-body h3 { font-family: "Playfair Display", serif; font-size: 1.7rem; color: var(--navy); line-height: 1.25; margin-bottom: 12px; }
    .project-body p { color: #374151; margin-bottom: 18px; }
    .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 22px; }
    .facts div { background: var(--bg-alt); border-radius: 10px; padding: 12px 14px; font-size: .8rem; color: var(--muted); }
    .facts b { display: block; color: var(--navy); font-size: .95rem; }

    /* ============ SKILLS ============ */
    .skills-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .skill-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; }
    .skill-card h3 { font-size: 1rem; color: var(--navy); margin-bottom: 16px; display: flex; align-items: center; gap: 10px; }
    .skill-card h3 i { font-style: normal; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--maroon-soft); }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .chips span { font-size: .85rem; padding: 7px 14px; border-radius: 999px; background: #f1f5f9; color: var(--navy-2); font-weight: 500; }

    /* ============ CERTIFICATES ============ */
    .cert-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .cert { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; transition: box-shadow .25s, transform .25s; }
    .cert:hover { box-shadow: var(--shadow); transform: translateY(-3px); }
    .cert-img { aspect-ratio: 4 / 3; background: repeating-linear-gradient(45deg, #f1f5f9, #f1f5f9 12px, #e9eef5 12px, #e9eef5 24px); display: grid; place-items: center; color: var(--muted); font-size: .82rem; text-align: center; padding: 16px; position: relative; }
    .cert-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; cursor: zoom-in; }
    .cert-img .ph b { display: block; font-size: 1.8rem; margin-bottom: 4px; }
    .cert-body { padding: 20px 22px 24px; flex: 1; display: flex; flex-direction: column; }
    .cert-body .kind { font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--maroon); }
    .cert-body h3 { font-size: 1.02rem; color: var(--navy); margin: 6px 0; line-height: 1.35; }
    .cert-body p { font-size: .88rem; color: var(--muted); margin-bottom: 12px; }
    .cert-body a { margin-top: auto; font-size: .85rem; font-weight: 600; color: var(--maroon); }
    .cert-body a:hover { text-decoration: underline; }
    .cert.add { border-style: dashed; background: transparent; place-items: center; justify-content: center; text-align: center; padding: 30px; color: var(--muted); font-size: .9rem; min-height: 240px; }
    .cert.add b { display: block; font-size: 2rem; color: var(--maroon); }

    /* ============ LEADERSHIP ============ */
    .lead-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .lead-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 26px; transition: box-shadow .25s, transform .25s; }
    .lead-card:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
    .lead-card h3 { color: var(--navy); font-size: 1.05rem; margin-bottom: 2px; }
    .lead-card .org { margin-bottom: 8px; }
    .lead-card p { font-size: .92rem; color: #374151; margin-top: 8px; }

    /* ============ INTERESTS ============ */
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .box { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
    .box h3 { color: var(--navy); margin-bottom: 16px; font-size: 1.05rem; }

    /* ============ CONTACT ============ */
    .contact { background: linear-gradient(135deg, var(--navy), #172036); color: #fff; }
    .contact h2.title { color: #fff; }
    .contact .lead { color: #cbd5e1; }
    .contact-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-bottom: 36px; }
    .c-card { display: block; padding: 24px; border-radius: var(--radius); background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.14); transition: background .2s, transform .2s; }
    .c-card:hover { background: rgba(255,255,255,.14); transform: translateY(-3px); }
    .c-card small { display: block; color: #cbd5e1; font-size: .78rem; text-transform: uppercase; letter-spacing: .1em; margin-bottom: 6px; }
    .c-card b { font-weight: 600; word-break: break-word; font-size: .98rem; }

    footer { background: #0a1020; color: #94a3b8; text-align: center; padding: 26px 0; font-size: .85rem; }

    /* ============ LIGHTBOX ============ */
    .lightbox { position: fixed; inset: 0; background: rgba(8,12,24,.88); display: none; place-items: center; z-index: 100; padding: 24px; cursor: zoom-out; }
    .lightbox.open { display: grid; }
    .lightbox img { max-height: 90vh; max-width: 92vw; border-radius: 10px; }

    /* ============ REVEAL ============ */
    .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s ease, transform .7s ease; }
    .reveal.in { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } html { scroll-behavior: auto; } }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 960px) {
      .hero-grid, .about-grid, .project { grid-template-columns: 1fr; }
      .photo-wrap { order: -1; }
      .stats { grid-template-columns: repeat(2, 1fr); }
      .edu-grid, .skills-grid, .cert-grid, .contact-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 760px) {
      section { padding: 64px 0; }
      .menu-btn { display: block; }
      .nav ul { position: absolute; top: 68px; left: 0; right: 0; background: #fff; flex-direction: column; align-items: stretch; gap: 0; padding: 8px 24px 18px; border-bottom: 1px solid var(--line); display: none; }
      .nav ul.open { display: flex; }
      .nav ul li { padding: 10px 0; border-bottom: 1px solid var(--line); }
      .nav ul li:last-child { border: 0; padding-top: 14px; }
      .edu-grid, .skills-grid, .cert-grid, .contact-grid, .lead-grid, .two-col { grid-template-columns: 1fr; }
      .facts { grid-template-columns: 1fr; }
      .project-body { padding: 26px; }
      .hero { padding-top: 120px; }
    }
    @media print { header, .menu-btn { display: none; } .reveal { opacity: 1; transform: none; } }
  </style>
</head>
