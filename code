  <script>
    /* =====================================================================
       CERTIFICATES: EDIT THIS LIST THIS EVENING
       ---------------------------------------------------------------------
       1. Create a folder named  images/certificates  next to index.html
       2. Save each certificate image there (jpg/png), e.g. lean-six-sigma.jpg
       3. Fill the  image  field below, e.g.  image: "images/certificates/lean-six-sigma.jpg"
       4. Optional:  link  = verification URL,  issuer / year = extra details
       5. To add more, copy one { ... }, block and paste it at the end of the list.
       Leave  image: ""  to show the "coming soon" placeholder.
       ===================================================================== */
    const certificates = [
      {
        type: "Course",
        title: "Semiconductor Fabrication Technology",
        issuer: "E&ICT Academy, IIT Roorkee",
        year: "",
        image: "",
        link: ""
      },
      {
        type: "Certification",
        title: "Lean Six Sigma (Yellow Belt)",
        issuer: "",
        year: "",
        image: "",
        link: ""
      },
      {
        type: "Certificate of Excellence",
        title: "Certificate of Excellence from Dassault Systèmes",
        issuer: "AAKRUTI GLOBAL 2024",
        year: "2024",
        image: "",
        link: ""
      },
      {
        type: "Award",
        title: "Best Student Coordinator Award",
        issuer: "Yuvarang '24, WCE Art Circle",
        year: "2024",
        image: "",
        link: ""
      },
      {
        type: "Award",
        title: "Second Runner-up in \"Convolution\"",
        issuer: "Vertex 2.0, WCE MESA-MESC",
        year: "",
        image: "",
        link: ""
      }
    ];

    /* ---------- build certificate cards ---------- */
    const esc = s => String(s).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    const grid = document.getElementById("certGrid");

    certificates.forEach(c => {
      const card = document.createElement("article");
      card.className = "cert reveal";
      const details = [c.issuer, c.year].filter(Boolean).map(esc).join(" &middot; ");
      card.innerHTML = `
        <div class="cert-img">
          ${c.image
            ? `<img src="${esc(c.image)}" alt="${esc(c.title)} certificate" loading="lazy" />`
            : `<div class="ph"><b>&#127891;</b>Certificate image<br />coming soon</div>`}
        </div>
        <div class="cert-body">
          <span class="kind">${esc(c.type)}</span>
          <h3>${esc(c.title)}</h3>
          ${details ? `<p>${details}</p>` : ""}
          ${c.link ? `<a href="${esc(c.link)}" target="_blank" rel="noopener">Verify credential &rarr;</a>` : ""}
        </div>`;
      grid.appendChild(card);
    });

    /* "add more" tile, delete this block if you don't want it */
    const add = document.createElement("div");
    add.className = "cert add reveal";
    add.innerHTML = `<div><b>+</b>More certificates<br />will be added soon</div>`;
    grid.appendChild(add);

    /* ---------- lightbox for certificate images ---------- */
    const lb = document.getElementById("lightbox"), lbImg = document.getElementById("lightboxImg");
    grid.addEventListener("click", e => {
      if (e.target.tagName === "IMG") { lbImg.src = e.target.src; lb.classList.add("open"); lb.setAttribute("aria-hidden", "false"); }
    });
    const closeLb = () => { lb.classList.remove("open"); lb.setAttribute("aria-hidden", "true"); };
    lb.addEventListener("click", closeLb);
    document.addEventListener("keydown", e => { if (e.key === "Escape") closeLb(); });

    /* ---------- mobile menu ---------- */
    const menuBtn = document.getElementById("menuBtn"), navLinks = document.getElementById("navLinks");
    menuBtn.addEventListener("click", () => {
      const open = navLinks.classList.toggle("open");
      menuBtn.setAttribute("aria-expanded", open);
    });
    navLinks.querySelectorAll("a").forEach(a => a.addEventListener("click", () => navLinks.classList.remove("open")));

    /* ---------- scroll reveal ---------- */
    const io = new IntersectionObserver(entries => {
      entries.forEach(en => { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } });
    }, { threshold: .12 });
    document.querySelectorAll(".reveal").forEach(el => io.observe(el));

    /* ---------- active nav link on scroll ---------- */
    const links = [...navLinks.querySelectorAll("a[href^='#']:not(.btn)")];
    const spy = new IntersectionObserver(entries => {
      entries.forEach(en => {
        if (en.isIntersecting) {
          links.forEach(l => l.classList.toggle("active", l.getAttribute("href") === "#" + en.target.id));
        }
      });
    }, { rootMargin: "-45% 0px -50% 0px" });
    links.forEach(l => { const s = document.querySelector(l.getAttribute("href")); if (s) spy.observe(s); });

    /* ---------- footer year ---------- */
    document.getElementById("year").textContent = new Date().getFullYear();
  </script>
